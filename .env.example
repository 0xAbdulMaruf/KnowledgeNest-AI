# ── Database ─────────────────────────────────────
# SQLite (local development)
DATABASE_URL=sqlite:///./academic_platform.db

# PostgreSQL (Docker / production)
# DATABASE_URL=postgresql://academic_user:academic_pass@localhost:5432/academic_db

# ── AI / LLM ─────────────────────────────────────
# Server-side AI configuration used by normal users
# Provider: local, openai, anthropic, or mimo
AI_PROVIDER=local
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Local Ollama fallback values
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional protected Developer Options access
# Set both values to allow temporary per-session overrides from Settings
AI_DEVELOPER_PASSWORD=
AI_DEVELOPER_TOKEN=
# Short-lived Developer Options session duration (minutes, default: 60)
# AI_DEVELOPER_TOKEN_TTL_MINUTES=60

# ── Faculty Auth ─────────────────────────────────
# Password teachers use to unlock the resource manager
FACULTY_TEACHER_PASSWORD=change-me

# HMAC secret for signing faculty session tokens
FACULTY_SESSION_SECRET=change-me-too

# Faculty session duration in hours (default: 12)
# FACULTY_TOKEN_TTL_HOURS=12

# ── ML ───────────────────────────────────────────
# Directory for cached recommendation models
# ML_MODEL_DIR=/tmp/academic_ml_models
